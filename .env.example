# ============================================================
# Salin file ini menjadi ".env" lalu isi nilainya.
# ".env" TIDAK boleh di-commit (sudah ada di .gitignore).
# ============================================================

# ---- Database ----
# Postgres hanya membaca password saat volume dibuat PERTAMA kali. Kalau diubah sesudahnya,
# hapus volume dulu: docker compose down -v   (data hilang)
# Jangan memakai titik koma (;) di password: connection string memakai tanda itu sebagai pemisah.
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_dev

# ---- API ----
# WAJIB. Acak, minimal 32 karakter. Siapa pun yang tahu kunci ini bisa memalsukan token login.
# PowerShell 7 : [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Git Bash     : openssl rand -base64 48
JWT_SIGNING_KEY=

# Membuat akun demo (admin@opspilot.local, responder@..., viewer@...) dengan password yang diketahui
# publik. HANYA untuk demo lokal. Jangan dinyalakan di server yang dapat diakses orang lain.
SEED_DEMO_DATA=true

# Menyalakan halaman Swagger di http://localhost:5130/swagger (demo lokal)
SWAGGER_ENABLED=true

# ---- Port di komputermu (semua hanya terbuka di 127.0.0.1) ----
# Mengubah WEB_PORT atau API_PORT membutuhkan build ulang: docker compose up --build
WEB_PORT=5173
API_PORT=5130
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6379