{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "OpsPilot",
    "Audience": "OpsPilot.Client",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Sla": {
    "Critical": {
      "ResponseMinutes": 15,
      "ResolutionMinutes": 240
    },
    "High": {
      "ResponseMinutes": 60,
      "ResolutionMinutes": 480
    },
    "Medium": {
      "ResponseMinutes": 240,
      "ResolutionMinutes": 1440
    },
    "Low": {
      "ResponseMinutes": 480,
      "ResolutionMinutes": 4320
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "AllowedHosts": "*"
}